<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hydro_ring_drone">

    <xacro:property name="arm_length" value="0.6"/>
    <xacro:property name="tank_radius" value="0.45"/> 
    <xacro:property name="prop_radius" value="0.25"/>

    <material name="matte_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
    </material>
    <material name="tech_blue"> <color rgba="0.0 0.2 0.5 1.0"/>
    </material>
    <material name="tank_grey"> <color rgba="0.3 0.3 0.3 1.0"/>
    </material>
    <material name="safety_orange">
        <color rgba="1.0 0.4 0.0 1.0"/>
    </material>
    <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
    </material>
    <material name="silver">
        <color rgba="0.8 0.8 0.8 1.0"/>
    </material>
    <material name="gold"> <color rgba="0.8 0.6 0.2 1.0"/>
    </material>

    <link name="base_footprint"/>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 2.0" rpy="0 0 0"/> </joint>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry><cylinder radius="0.20" length="0.02"/></geometry>
            <material name="matte_black"/>
        </visual>
        <visual>
            <geometry><cylinder radius="0.18" length="0.12"/></geometry>
            <material name="dark_grey"/>
        </visual>
        <visual>
            <origin xyz="0 0 -0.06" rpy="0 0 0"/>
            <geometry><cylinder radius="0.22" length="0.01"/></geometry>
            <material name="gold"/>
        </visual>
        <collision>
            <geometry><cylinder radius="0.25" length="0.15"/></geometry>
        </collision>
    </link>

    <xacro:macro name="tank_segment" params="id angle">
        <link name="tank_seg_${id}">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/> 
                <geometry>
                    <box size="0.12 0.45 0.15"/> 
                </geometry>
                <material name="tech_blue"/>
            </visual>
            
            <visual>
                <origin xyz="0 0 0.08" rpy="0 0 0"/>
                <geometry>
                    <box size="0.08 0.3 0.02"/>
                </geometry>
                <material name="tank_grey"/>
            </visual>

            <visual>
                <origin xyz="0.06 0 0" rpy="0 1.5708 0"/>
                <geometry>
                    <cylinder radius="0.015" length="0.05"/>
                </geometry>
                <material name="silver"/>
            </visual>
        </link>

        <joint name="tank_seg_${id}_joint" type="fixed">
            <parent link="base_link"/>
            <child link="tank_seg_${id}"/>
            <origin xyz="${0.38 * cos(angle)} ${0.38 * sin(angle)} 0" 
                    rpy="0 0 ${angle}"/> 
        </joint>
        
        <link name="tank_corner_${id}">
            <visual>
                <geometry><cylinder radius="0.09" length="0.16"/></geometry>
                <material name="tank_grey"/>
            </visual>
        </link>
        <joint name="tank_corner_${id}_joint" type="fixed">
            <parent link="base_link"/>
            <child link="tank_corner_${id}"/>
            <origin xyz="${0.44 * cos(angle + 0.523)} ${0.44 * sin(angle + 0.523)} 0" 
                    rpy="0 0 0"/>
        </joint>
    </xacro:macro>

    <xacro:tank_segment id="1" angle="0"/>
    <xacro:tank_segment id="2" angle="1.047"/>
    <xacro:tank_segment id="3" angle="2.094"/>
    <xacro:tank_segment id="4" angle="3.141"/>
    <xacro:tank_segment id="5" angle="4.188"/>
    <xacro:tank_segment id="6" angle="5.235"/>


    <xacro:macro name="drone_arm" params="id angle">
        <link name="arm_${id}">
            <visual>
                <geometry>
                    <box size="${arm_length} 0.04 0.02"/>
                </geometry>
                <material name="matte_black"/>
            </visual>
        </link>
        <joint name="arm_${id}_joint" type="fixed">
            <parent link="base_link"/>
            <child link="arm_${id}"/>
            <origin xyz="${(arm_length/2 + 0.1) * cos(angle)} ${(arm_length/2 + 0.1) * sin(angle)} 0.08" 
                    rpy="0 0 ${angle}"/>
        </joint>

        <link name="motor_mount_${id}">
            <visual>
                <geometry><cylinder radius="0.05" length="0.06"/></geometry>
                <material name="dark_grey"/>
            </visual>
        </link>
        <joint name="mount_${id}_joint" type="fixed">
            <parent link="arm_${id}"/>
            <child link="motor_mount_${id}"/>
            <origin xyz="${arm_length/2} 0 0" rpy="0 0 0"/>
        </joint>

        <link name="motor_${id}">
            <visual>
                <geometry><cylinder radius="0.04" length="0.14"/></geometry>
                <material name="safety_orange"/>
            </visual>
        </link>
        <joint name="motor_${id}_joint" type="fixed">
            <parent link="motor_mount_${id}"/>
            <child link="motor_${id}"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </joint>

        <link name="prop_top_${id}">
            <visual>
                <geometry><box size="${prop_radius*2} 0.02 0.005"/></geometry>
                <material name="silver"/>
            </visual>
            <visual>
                <origin rpy="0 0 1.5708"/>
                <geometry><box size="${prop_radius*2} 0.02 0.005"/></geometry>
                <material name="silver"/>
            </visual>
        </link>
        <joint name="prop_top_${id}_joint" type="continuous">
            <parent link="motor_${id}"/>
            <child link="prop_top_${id}"/>
            <origin xyz="0 0 0.075" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>

        <link name="prop_bot_${id}">
            <visual>
                <geometry><box size="${prop_radius*2} 0.02 0.005"/></geometry>
                <material name="silver"/>
            </visual>
            <visual>
                <origin rpy="0 0 1.5708"/>
                <geometry><box size="${prop_radius*2} 0.02 0.005"/></geometry>
                <material name="silver"/>
            </visual>
        </link>
        <joint name="prop_bot_${id}_joint" type="continuous">
            <parent link="motor_${id}"/>
            <child link="prop_bot_${id}"/>
            <origin xyz="0 0 -0.075" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>
    </xacro:macro>

    <xacro:drone_arm id="1" angle="0"/>
    <xacro:drone_arm id="2" angle="1.047"/>
    <xacro:drone_arm id="3" angle="2.094"/>
    <xacro:drone_arm id="4" angle="3.141"/>
    <xacro:drone_arm id="5" angle="4.188"/>
    <xacro:drone_arm id="6" angle="5.235"/>


    <xacro:macro name="pontoon" params="side reflect">
        <link name="leg_${side}">
            <visual>
                <geometry><cylinder radius="0.025" length="0.5"/></geometry>
                <material name="matte_black"/>
            </visual>
        </link>
        <joint name="leg_${side}_joint" type="fixed">
            <parent link="base_link"/>
            <child link="leg_${side}"/>
            <origin xyz="0 ${reflect * 0.4} -0.2" rpy="0.4 0 0"/>
        </joint>

        <link name="pontoon_${side}">
            <visual>
                <geometry><capsule radius="0.12" length="1.4"/></geometry>
                <material name="dark_grey"/>
            </visual>
            <visual> <origin xyz="0 0 0.1"/>
                <geometry><box size="1.0 0.15 0.02"/></geometry>
                <material name="safety_orange"/>
            </visual>
        </link>
        <joint name="pontoon_${side}_joint" type="fixed">
            <parent link="leg_${side}"/>
            <child link="pontoon_${side}"/>
            <origin xyz="0 0 -0.25" rpy="1.5708 0 0"/>
        </joint>
    </xacro:macro>

    <xacro:pontoon side="left" reflect="1"/>
    <xacro:pontoon side="right" reflect="-1"/>

    <link name="parachute_link">
        <visual>
            <geometry><cylinder radius="0.1" length="0.15"/></geometry>
            <material name="safety_orange"/>
        </visual>
    </link>
    <joint name="parachute_joint" type="fixed">
        <parent link="base_link"/>
        <child link="parachute_link"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </joint>

    <link name="wifi_antenna_link">
        <visual>
            <geometry><cylinder radius="0.015" length="0.3"/></geometry>
            <material name="matte_black"/>
        </visual>
    </link>
    <joint name="wifi_joint" type="fixed">
        <parent link="base_link"/>
        <child link="wifi_antenna_link"/>
        <origin xyz="0.2 0 0.15" rpy="0 0 0"/>
    </joint>

    <link name="thermal_cam_link">
        <visual>
            <geometry><sphere radius="0.05"/></geometry>
            <material name="silver"/>
        </visual>
    </link>
    <joint name="thermal_cam_joint" type="fixed">
        <parent link="base_link"/>
        <child link="thermal_cam_link"/>
        <origin xyz="0.28 0 -0.05" rpy="0 0.5 0"/>
    </joint>

</robot>